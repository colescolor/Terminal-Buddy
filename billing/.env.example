# TEST MODE ONLY. Keep this file's placeholders empty; use an untracked .env.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_MONTHLY_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
# Public CA PEM supplied by the database provider; verify-full remains required.
DATABASE_CA_CERT=
BILLING_ORIGIN=
ENTITLEMENT_PRIVATE_KEY=
# Server-only, comma-separated verified Supabase user UUIDs. Empty disables owner data access.
OWNER_USER_IDS=
# Optional server-only subscriber alerts. Use a NEW domain-restricted Sending
# key; do not copy Supabase's SMTP credential. All three enable email delivery.
RESEND_API_KEY=
SUBSCRIBER_ALERT_FROM=
SUBSCRIBER_ALERT_TO=
# Resend SMTP credentials belong in Supabase Auth settings, not this app or its browser bundle.
# Proposed defaults; owner approval required before publication.
OFFLINE_DAYS=7
PAST_DUE_GRACE_DAYS=3
